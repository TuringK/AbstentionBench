# env.sh — Per-user environment settings
# Copy this file to env.sh and fill in your values.
# env.sh is gitignored and should NOT be committed.

export USER_NAME="your_username"
export USER_EMAIL=""  # optional: set for SLURM email notifications
export PROJECT_ROOT="/mnt/parscratch/users/${USER_NAME}/private/projects/AbstentionBench"
export PYTHON_BIN="/mnt/parscratch/users/${USER_NAME}/private/mamba/envs/abstention-bench/bin/python"
